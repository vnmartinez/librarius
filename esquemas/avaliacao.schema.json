{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_esquema",
    "avaliacao"
  ],
  "properties": {
    "versao_esquema": {
      "const": 1
    },
    "avaliacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "etapa",
        "turmas",
        "data",
        "questoes",
        "semente"
      ],
      "properties": {
        "etapa": {
          "type": "string",
          "pattern": "^N[0-9]$"
        },
        "turmas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "aulas_cobertas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Aula [0-9]{2}$"
          }
        },
        "objetivos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questoes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enunciado",
              "tipo",
              "resposta",
              "pontos"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enunciado": {
                "type": "string"
              },
              "tipo": {
                "enum": [
                  "multipla-escolha",
                  "discursiva",
                  "verdadeiro-falso"
                ]
              },
              "alternativas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resposta": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              },
              "objetivos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aulas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^Aula [0-9]{2}$"
                }
              },
              "bloom": {
                "enum": [
                  "lembrar",
                  "entender",
                  "aplicar",
                  "analisar",
                  "avaliar",
                  "criar"
                ]
              },
              "pontos": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "semente": {
          "type": "integer"
        },
        "arquivos": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "prova": {
              "type": "string"
            },
            "gabarito": {
              "type": "string"
            }
          }
        },
        "manifesto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artefatos",
            "gerado_em",
            "entradas",
            "aprovado",
            "versao_acad"
          ],
          "properties": {
            "artefatos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gerado_em": {
              "type": "string"
            },
            "entradas": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "aprovado": {
              "type": "boolean"
            },
            "aprovado_em": {
              "type": [
                "string",
                "null"
              ]
            },
            "versao_acad": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vnmartinez/librarius/esquemas/avaliacao.schema.json"
}
