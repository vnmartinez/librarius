{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_esquema",
    "turma"
  ],
  "properties": {
    "versao_esquema": {
      "const": 1
    },
    "turma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "disciplina",
        "fuso",
        "horarios"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[0-9]?$"
        },
        "disciplina": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,10}$"
        },
        "fuso": {
          "type": "string"
        },
        "horarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dia_semana",
              "inicio",
              "fim"
            ],
            "properties": {
              "dia_semana": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "inicio": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "fim": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "sala": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        },
        "excecoes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "data"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "cancelamento",
                  "reposicao"
                ]
              },
              "data": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "motivo": {
                "type": "string"
              },
              "inicio": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "fim": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "repoe": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "if": {
              "properties": {
                "tipo": {
                  "const": "reposicao"
                }
              }
            },
            "then": {
              "required": [
                "inicio",
                "fim",
                "repoe"
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vnmartinez/librarius/esquemas/turma.schema.json"
}
