{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_esquema",
    "disciplina"
  ],
  "properties": {
    "versao_esquema": {
      "const": 1
    },
    "disciplina": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo",
        "nome",
        "pasta",
        "semestre",
        "carga_horaria"
      ],
      "properties": {
        "codigo": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,10}$"
        },
        "nome": {
          "type": "string"
        },
        "pasta": {
          "type": "string"
        },
        "semestre": {
          "type": "string",
          "pattern": "^\\d{4}-[12]$"
        },
        "carga_horaria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valor",
            "unidade"
          ],
          "properties": {
            "valor": {
              "type": "number",
              "minimum": 0
            },
            "unidade": {
              "enum": [
                "hora_relogio",
                "hora_aula",
                null
              ]
            },
            "minutos_hora_aula": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "if": {
            "properties": {
              "unidade": {
                "const": "hora_aula"
              }
            },
            "required": [
              "unidade"
            ]
          },
          "then": {
            "properties": {
              "minutos_hora_aula": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "minutos_hora_aula"
            ]
          }
        },
        "objetivos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "descricao",
              "bloom"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "descricao": {
                "type": "string"
              },
              "bloom": {
                "enum": [
                  "lembrar",
                  "entender",
                  "aplicar",
                  "analisar",
                  "avaliar",
                  "criar"
                ]
              }
            }
          }
        },
        "configuracao": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template_slides",
            "template_provas",
            "idioma"
          ],
          "properties": {
            "template_slides": {
              "type": "string"
            },
            "template_provas": {
              "type": "string"
            },
            "idioma": {
              "type": "string"
            }
          }
        },
        "planejamento": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "rascunho",
                "aprovado"
              ]
            },
            "aprovado_em": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vnmartinez/librarius/esquemas/disciplina.schema.json"
}
