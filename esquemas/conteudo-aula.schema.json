{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tema", "roteiro"],
  "properties": {
    "tema": {"type": "string", "minLength": 1},
    "professor": {"type": "string"},
    "periodo": {"type": "string"},
    "roteiro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objetivo", "blocos"],
      "properties": {
        "objetivo": {"type": "string"},
        "blocos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["titulo", "minutos", "texto"],
            "properties": {
              "titulo": {"type": "string"},
              "minutos": {"type": "integer", "minimum": 1},
              "texto": {"type": "string"}
            }
          }
        }
      }
    },
    "codigo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arquivos"],
      "properties": {
        "arquivos": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "lista": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questoes"],
      "properties": {
        "questoes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enunciado"],
            "properties": {
              "enunciado": {"type": "string"},
              "resposta": {"type": "string"}
            }
          }
        }
      }
    },
    "slides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slides"],
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tipo"],
            "properties": {
              "tipo": {"enum": ["capa", "topicos", "codigo", "tabela", "nota", "cards", "fluxo", "referencias"]}
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
