{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_esquema",
    "gerado_por",
    "gerado_em",
    "entradas",
    "encontros"
  ],
  "properties": {
    "versao_esquema": {
      "const": 1
    },
    "gerado_por": {
      "type": "string"
    },
    "gerado_em": {
      "type": "string"
    },
    "entradas": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "encontros": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "data",
          "inicio",
          "fim",
          "status",
          "aulas",
          "funcao",
          "origem"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{2,3}$"
          },
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "inicio": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "fim": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "status": {
            "enum": [
              "previsto",
              "realizado",
              "cancelado"
            ]
          },
          "aulas": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^Aula [0-9]{2}$"
            }
          },
          "funcao": {
            "enum": [
              "conteudo",
              "revisao",
              "avaliacao"
            ]
          },
          "origem": {
            "enum": [
              "horario",
              "reposicao",
              "sabado-letivo",
              "planilha"
            ]
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vnmartinez/librarius/esquemas/encontro.schema.json"
}
