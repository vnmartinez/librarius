{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_esquema",
    "questao"
  ],
  "properties": {
    "versao_esquema": {
      "const": 1
    },
    "questao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enunciado",
        "tipo",
        "resposta",
        "pontos"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "enunciado": {
          "type": "string"
        },
        "tipo": {
          "enum": [
            "multipla-escolha",
            "discursiva",
            "verdadeiro-falso"
          ]
        },
        "alternativas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resposta": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "objetivos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aulas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Aula [0-9]{2}$"
          }
        },
        "bloom": {
          "enum": [
            "lembrar",
            "entender",
            "aplicar",
            "analisar",
            "avaliar",
            "criar"
          ]
        },
        "pontos": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vnmartinez/librarius/esquemas/questao.schema.json"
}
